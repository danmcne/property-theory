% [time/axiom] No instant is before itself.
tff(time_irreflexive, axiom,
    ![T:tm]: ~ before(T,T)).
% [time/axiom] If A is before B and B is before C, then A is before C.
tff(time_transitive, axiom,
    ![A:tm,B:tm,C:tm]: ((before(A,B) & before(B,C)) => before(A,C))).
% [time/axiom] Any two instants are equal or one is before the other.
tff(time_total, axiom,
    ![A:tm,B:tm]: (before(A,B) | before(B,A) | (A = B))).
% [time/axiom] There are at least two instants.
tff(time_nonempty, axiom,
    ?[A:tm,B:tm]: before(A,B)).
% [entities/axiom] Nothing is both a person and an object.
tff(entity_disjoint, axiom,
    ![X:en]: ~ (person(X) & np_obj(X))).
% [entities/axiom] There are at least two persons.
tff(two_persons, axiom,
    ?[P1:en,P2:en]: (person(P1) & person(P2) & (P1 != P2))).
% [entities/axiom] There is at least one object.
tff(an_object, axiom,
    ?[O:en]: np_obj(O)).
% [entities/axiom] Every body is scarce: some two uses of it clash.
tff(persons_rivalrous, axiom,
    ![P:en]: (person(P) => rivalrous(P))).
% [typing/axiom] Only persons use things; what they use is an object or a body.
tff(use_typing, axiom,
    ![P:en,O:en,M:man,T:tm]: (use(P,O,M,T) => (person(P) & (np_obj(O) | person(O))))).
% [typing/axiom] Only persons claim, and only objects are claimed.
tff(claim_typing, axiom,
    ![P:en,O:en,T:tm]: (claim(P,O,T) => (person(P) & np_obj(O)))).
% [typing/axiom] A title is held by a person against another person, over an object or the holder's own body.
tff(owns_typing, axiom,
    ![P:en,O:en,Q:en,M:man,T:tm]: (owns(P,O,Q,M,T) => (person(P) & person(Q) & (P != Q) & (np_obj(O) | (O = P))))).
% [typing/axiom] Only a title that is actually held over an object can be released.
tff(disowns_typing, axiom,
    ![P:en,O:en,Q:en,M:man,T:tm]: (disowns(P,O,Q,M,T) => (owns(P,O,Q,M,T) & np_obj(O)))).
% [typing/axiom] Only an owner grants, only titles over an object, and only to another person.
tff(grant_typing, axiom,
    ![R:en,P:en,O:en,Q:en,M:man,T:tm]: (grants(R,P,O,Q,M,T) => (is_owner(R,O,T) & np_obj(O) & person(P) & (R != P)))).
% [persons/axiom] Every person holds a title over his or her body against every other person, in every manner, at every instant.
tff(self_ownership, axiom,
    ![P:en,Q:en,M:man,T:tm]: ((person(P) & person(Q) & (P != Q)) => owns(P,P,Q,M,T))).
% [title/definition] The title of P against Q over O in manner M is not released in the window [T1,T2).
tff(nodis_upto_def, axiom,
    ![P:en,O:en,Q:en,M:man,T1:tm,T2:tm]: (nodis_upto(P,O,Q,M,T1,T2) <=> ![T:tm]: ((((T = T1) | before(T1,T)) & before(T,T2)) => ~ disowns(P,O,Q,M,T)))).
% [title/definition] An acquisition event for a title: P homesteads O (uses and claims it while it is scarce and unowned), or P accepts a grant of the title from someone who holds it, or from Q himself.
tff(acquires_def, axiom,
    ![P:en,O:en,Q:en,M:man,T:tm]: (acquires(P,O,Q,M,T) <=> (?[M2:man]: (rivalrous(O) & use(P,O,M2,T) & claim(P,O,T) & unowned(O,T)) | ?[R:en]: (grants(R,P,O,Q,M,T) & accepts(P,R,O,T) & (owns(R,O,Q,M,T) | (Q = R)))))).
% [title/axiom] After an acquisition event, the title holds at every later instant until it is released.
tff(title_acquired, axiom,
    ![P:en,O:en,Q:en,M:man,T1:tm,T2:tm]: ((acquires(P,O,Q,M,T1) & person(Q) & (P != Q) & before(T1,T2) & nodis_upto(P,O,Q,M,T1,T2)) => owns(P,O,Q,M,T2))).
% [title/axiom] A title over an object holds only because of an earlier acquisition event that was not released since.
tff(title_genesis, axiom,
    ![P:en,O:en,Q:en,M:man,T2:tm]: ((owns(P,O,Q,M,T2) & np_obj(O)) => ?[T1:tm]: (before(T1,T2) & acquires(P,O,Q,M,T1) & nodis_upto(P,O,Q,M,T1,T2)))).
% [ownership/definition] A holder of rights over O is someone who holds at least one title over O.
tff(is_owner_def, axiom,
    ![P:en,O:en,T:tm]: (is_owner(P,O,T) <=> ?[Q:en,M:man]: owns(P,O,Q,M,T))).
% [ownership/definition] A full owner of O holds a title against every other person in every manner.
tff(full_owner_def, axiom,
    ![P:en,O:en,T:tm]: (full_owner(P,O,T) <=> ![Q:en,M:man]: ((person(Q) & (Q != P)) => owns(P,O,Q,M,T)))).
% [ownership/definition] O is unowned when nobody holds any title over it.
tff(unowned_def, axiom,
    ![O:en,T:tm]: (unowned(O,T) <=> ![P:en]: ~ is_owner(P,O,T))).
% [transfer/definition] R shares manner M of O with P: R grants P every title in M that R holds, and a title in M against R himself.
tff(shares_def, axiom,
    ![R:en,P:en,O:en,M:man,T:tm]: (shares(R,P,O,M,T) <=> (grants(R,P,O,R,M,T) & ![Q:en]: ((owns(R,O,Q,M,T) & (Q != P)) => grants(R,P,O,Q,M,T))))).
% [transfer/definition] A share gift: R shares every manner of O with P. R keeps his own titles.
tff(gives_share_def, axiom,
    ![R:en,P:en,O:en,T:tm]: (gives_share(R,P,O,T) <=> ![M:man]: shares(R,P,O,M,T))).
% [transfer/definition] R transfers manner M of O to P: R shares manner M with P and releases all his titles in M. A lease is such a transfer for the leased manners.
tff(transfers_manner_def, axiom,
    ![R:en,P:en,O:en,M:man,T:tm]: (transfers_manner(R,P,O,M,T) <=> (shares(R,P,O,M,T) & ![Q:en]: (owns(R,O,Q,M,T) => disowns(R,O,Q,M,T))))).
% [transfer/definition] A transfer: a share gift and an abandonment at the same instant.
tff(vol_transfer_def, axiom,
    ![R:en,P:en,O:en,T:tm]: (vol_transfer(R,P,O,T) <=> (gives_share(R,P,O,T) & abandons(R,O,T)))).
% [abandonment/definition] To abandon is to release every title one holds over an object.
tff(abandons_def, axiom,
    ![P:en,O:en,T:tm]: (abandons(P,O,T) <=> (np_obj(O) & is_owner(P,O,T) & ![Q:en,M:man]: (owns(P,O,Q,M,T) => disowns(P,O,Q,M,T))))).
% [use/definition] Q may use O in manner M unless someone who holds a title against Q over O in M, and has not forfeited it, does not consent.
tff(may_use_def, axiom,
    ![Q:en,O:en,M:man,T:tm]: (may_use(Q,O,M,T) <=> ![R:en]: ((owns(R,O,Q,M,T) & ~ forfeits(R,O,Q,T)) => consents(R,O,Q,M,T)))).
% [use/definition] A use is forbidden exactly when it is not permitted.
tff(forbidden_use_def, axiom,
    ![Q:en,O:en,M:man,T:tm]: (forbidden_use(Q,O,M,T) <=> ~ may_use(Q,O,M,T))).
% [use/definition] P's action in manner M aggresses against Q when it uses something over which Q holds an unforfeited title against P in M, without Q's consent.
tff(aggresses_in_def, axiom,
    ![P:en,Q:en,M:man,T:tm]: (aggresses_in(P,Q,M,T) <=> ?[O:en]: (use(P,O,M,T) & owns(Q,O,P,M,T) & ~ forfeits(Q,O,P,T) & ~ consents(Q,O,P,M,T)))).
% [use/definition] P aggresses against Q when some action of P aggresses against Q.
tff(aggresses_def, axiom,
    ![P:en,Q:en,T:tm]: (aggresses(P,Q,T) <=> ?[M:man]: aggresses_in(P,Q,M,T))).
% [use/definition] While R aggresses against Q, R forfeits, with respect to Q, his titles over his own body and over the things he uses in the aggressing action. Q may use them without R's consent.
tff(forfeits_def, axiom,
    ![R:en,O:en,Q:en,T:tm]: (forfeits(R,O,Q,T) <=> ?[M:man]: (aggresses_in(R,Q,M,T) & ((O = R) | use(R,O,M,T))))).
% [use/definition] An action is permissible when each thing it uses may be used in that manner.
tff(permissible_def, axiom,
    ![P:en,M:man,T:tm]: (permissible(P,M,T) <=> ![O:en]: (use(P,O,M,T) => may_use(P,O,M,T)))).
% [use/definition] P controls O when P may use O in every manner and every other person may use O exactly when P consents.
tff(controls_def, axiom,
    ![P:en,O:en,T:tm]: (controls(P,O,T) <=> (![M:man]: may_use(P,O,M,T) & ![Q:en,M:man]: ((person(Q) & (Q != P)) => (may_use(Q,O,M,T) <=> consents(P,O,Q,M,T)))))).
% [scarcity/definition] A thing is scarce when some two uses of it clash.
tff(rivalrous_def, axiom,
    ![O:en]: (rivalrous(O) <=> ?[M1:man,M2:man]: clash(O,M1,M2))).
% [scarcity/axiom] Two different use events in clashing manners do not happen at the same instant.
tff(clash_factual, axiom,
    ![O:en,P1:en,P2:en,M1:man,M2:man,T:tm]: ((clash(O,M1,M2) & ~ ((P1 = P2) & (M1 = M2))) => ~ (use(P1,O,M1,T) & use(P2,O,M2,T)))).
% [scarcity/axiom] Things that are not scarce (ideas, patterns) are never owned.
tff(nonrivalrous_unowned, axiom,
    ![O:en,T:tm]: (~ rivalrous(O) => unowned(O,T))).
% [scarcity/axiom] At some instant some object is unowned (there is a state of nature).
tff(unowned_exists, axiom,
    ?[O:en,T:tm]: (np_obj(O) & unowned(O,T))).
% [scarcity/definition] A want is unrealised when the wanted use does not happen.
tff(unrealised_def, axiom,
    ![P:en,O:en,M:man,T:tm]: (unrealised(P,O,M,T) <=> (wants(P,O,M,T) & ~ use(P,O,M,T)))).

% ============================================================
% FORMAL THF AXIOMATIZATION OF LIBERTARIAN PROPERTY THEORY
% Version 13.0  |  Prover: Leo-III v1.7.18
% ============================================================
%
% This file is the consolidated RECORD of the theory: all type
% declarations, axioms, and (proved) theorems in one place. It is
% NOT meant to be run whole — Leo-III is run on the per-theorem
% MINIMAL files (see ./minimal/ and the README), each carrying only
% the axioms/lemmas a given theorem needs. This two-track workflow
% avoids the deontic/temporal search blow-ups that time out the full
% theory. Version history and rationale live in CHANGELOG.md; the
% planned work lives in ROADMAP.md.
%
% DESIGN OVERVIEW
%   Ownership is the right to exclude others from using a RIVALROUS
%   resource. Following Hohfeld it is relational: owns(P,O,Q,T) is a
%   claim-right of P against Q over O at T; Q bears the correlative
%   duty not to use O without P's permission. Acquisition is by
%   homesteading (first use in some manner + public claim of an
%   unowned non-person object) or by voluntary transfer. Ownership
%   persists until abandoned or transferred, where a disowning event
%   both blocks persistence (nodis) and extinguishes title
%   (disown_extinguishes), absent re-acquisition.
%
%   NEW IN v13 — RIVALROUSNESS AND MANNER OF USE
%   use(P,O,M,T) now carries a MANNER/purpose M. Two uses conflict
%   only when the object is rivalrous AND the manners are mutually
%   exclusive (excl). The NAP is guarded by rivalrous(O): trespass is
%   interference with control over a SCARCE resource (Kinsella). A
%   non-owner's use of a non-rivalrous good is therefore not
%   aggression. Joint ownership is consistent: co-owners with clashing
%   exclusive intentions cannot both realise their use (excl_factual),
%   so at least one intended use is unrealised — UNDER-UTILIZATION,
%   a coordination loss, NOT a logical contradiction. Crucially, the
%   permission layer (owner_use_permitted) and the physical-exclusion
%   layer (excl_factual) are kept separate; forcing every permitted
%   intention into realisation is exactly what re-introduces
%   inconsistency, and is deliberately NOT asserted.
%
% KEY DESIGN DECISIONS
%   - Sorts tm (time), en (entities), man (manners/purposes of use)
%   - Time: strict total order; no density/successor (dense+discrete ok)
%   - person and np_obj disjoint; bodies are rivalrous (person_rivalrous)
%   - use(P,O,M,T) admits np_obj or person O (NAP protects the body)
%   - excl is a relation on manners; object-relative exclusivity is a
%     roadmap item (a manner-pair exclusive on one object, not another)
%   - Deontic operators are $o > $o (KD + liberty); see CHANGELOG for
%     the extensionality caveat and the Kripke upgrade path
%   - Ownership is primitive (NOT defined via permission); exclusion is
%     derived through the NAP. An exclusion-primitive refactor is a
%     roadmap item
%   - The no-disowns interval condition is atomised as nodis(P,O,Q,T1,T2)
%     (def: nodis_def) so cross-lemma matching stays first-order; this
%     is what lets first_homesteader_exclusive_v2 (D) close instead of
%     timing out on the raw nested quantifier
% ============================================================


% ============================================================
% SECTION 1 — SORTS
% ============================================================
thf(tm_sort,  type, tm:  $tType).   % instants
thf(en_sort,  type, en:  $tType).   % entities (persons + objects)
thf(man_sort, type, man: $tType).   % manners / purposes of use


% ============================================================
% SECTION 2 — TIME: STRICT TOTAL ORDER
% ============================================================
thf(before_decl, type, before: tm > tm > $o).
thf(time_irrefl, axiom, ![T:tm]: ~before(T,T)).
thf(time_trans,  axiom, ![T1:tm,T2:tm,T3:tm]: ((before(T1,T2)&before(T2,T3)) => before(T1,T3))).
thf(time_total,  axiom, ![T1:tm,T2:tm]: (before(T1,T2) | before(T2,T1) | (T1=T2))).
thf(time_nonempty, axiom, ?[T1:tm,T2:tm]: before(T1,T2)).


% ============================================================
% SECTION 3 — ENTITIES
% ============================================================
thf(person_decl, type, person: en > $o).
thf(np_obj_decl, type, np_obj: en > $o).
thf(entity_disjoint, axiom, ![X:en]: ~(person(X) & np_obj(X))).
thf(exist_persons, axiom, ?[P1:en,P2:en]: (person(P1)&person(P2)&(P1!=P2))).
thf(exist_np_obj,  axiom, ?[O:en]: np_obj(O)).


% ============================================================
% SECTION 3b — RIVALROUSNESS (scarcity)
% rivalrous(O): O is a scarce resource whose control is conflictable.
% Bodies are rivalrous (a body cannot be jointly controlled). Whether
% a given np_obj is rivalrous is left open: non-rivalrous objects model
% non-scarce goods (e.g. informational patterns), for which the NAP
% does not generate a duty of non-use.
% ============================================================
thf(rivalrous_decl, type, rivalrous: en > $o).
thf(person_rivalrous, axiom, ![P:en]: (person(P) => rivalrous(P))).


% ============================================================
% SECTION 4 — USE (manner-indexed)
% use(P,O,M,T): person P acts on entity O in manner/purpose M at T.
% ============================================================
thf(use_decl, type, use: en > en > man > tm > $o).
thf(use_typing, axiom,
    ![P:en,O:en,M:man,T:tm]: (use(P,O,M,T) => (person(P) & (np_obj(O) | person(O))))).


% ============================================================
% SECTION 5 — CLAIMS
% ============================================================
thf(claim_decl, type, claim: en > en > tm > $o).
thf(claim_typing, axiom,
    ![P:en,O:en,T:tm]: (claim(P,O,T) => (person(P) & np_obj(O)))).


% ============================================================
% SECTION 6 — OWNERSHIP
% ============================================================
thf(owns_decl, type, owns: en > en > en > tm > $o).
thf(owns_typing, axiom,
    ![P:en,O:en,Q:en,T:tm]:
        (owns(P,O,Q,T) => (person(P) & (np_obj(O) | (O=P)) & person(Q) & (P!=Q)))).
thf(anti_slavery, axiom,
    ![P:en,O:en,Q:en,T:tm]: ((person(P)&person(O)&(P!=O)) => ~owns(P,O,Q,T))).
thf(self_ownership, axiom,
    ![P:en,Q:en,T:tm]: ((person(P)&person(Q)&(P!=Q)) => owns(P,P,Q,T))).


% ============================================================
% SECTION 7 — IS-OWNER, UNOWNED
% ============================================================
thf(is_owner_decl, type, is_owner: en > en > tm > $o).
thf(is_owner_def, axiom,
    ![P:en,O:en,T:tm]: (is_owner(P,O,T) <=> ?[Q:en]: owns(P,O,Q,T))).
thf(unowned_decl, type, unowned: en > tm > $o).
thf(unowned_def, axiom,
    ![O:en,T:tm]: (unowned(O,T) <=> (![P:en]: ~is_owner(P,O,T)))).
thf(exist_unowned, axiom, ?[O:en,T:tm]: (np_obj(O) & unowned(O,T))).


% ============================================================
% SECTION 8 — HOMESTEADING (temporal offset T1 -> T2)
% First use (in some manner) + claim of an unowned np_obj at T1
% establishes ownership from T2 > T1. Simultaneous homesteading yields
% co-ownership (handled by the NAP co-owner guard + all-owner consent).
% ============================================================
thf(homesteading, axiom,
    ![P:en,O:en,Q:en,M:man,T1:tm,T2:tm]:
        ((person(P)&np_obj(O)&use(P,O,M,T1)&claim(P,O,T1)&unowned(O,T1)&
          before(T1,T2)&person(Q)&(P!=Q)) => owns(P,O,Q,T2))).


% ============================================================
% SECTION 9 — DISOWNERSHIP, PERSISTENCE, EXTINCTION
% ============================================================
thf(disowns_decl, type, disowns: en > en > en > tm > $o).
thf(disowns_typing, axiom,
    ![P:en,O:en,Q:en,T:tm]:
        (disowns(P,O,Q,T) => (person(P)&np_obj(O)&person(Q)&(P!=Q)&owns(P,O,Q,T)))).

% nodis(P,O,Q,T1,T2): no disowning of O by P against Q anywhere in [T1,T2].
% Atomised frame condition; def pins the meaning.
thf(nodis_decl, type, nodis: en > en > en > tm > tm > $o).
thf(nodis_def, axiom,
    ![P:en,O:en,Q:en,T1:tm,T2:tm]:
        (nodis(P,O,Q,T1,T2) <=>
         (![T:tm]: ((((T=T1)|before(T1,T)) & ((T=T2)|before(T,T2))) => ~disowns(P,O,Q,T))))).

% Persistence: ownership carries forward across a disown-free interval.
thf(ownership_persistence, axiom,
    ![P:en,O:en,Q:en,T1:tm,T2:tm]:
        ((owns(P,O,Q,T1) & before(T1,T2) & nodis(P,O,Q,T1,T2)) => owns(P,O,Q,T2))).

% Extinction: a disowning event terminates title at the next instant,
% absent a re-acquisition event in the interval. This is what makes
% abandonment and transfer actually REMOVE the prior owner's title
% (persistence alone only fails to propagate it).
thf(reacquires_decl, type, reacquires: en > en > en > tm > tm > $o).
thf(disown_extinguishes, axiom,
    ![P:en,O:en,Q:en,T1:tm,T2:tm]:
        ((disowns(P,O,Q,T1) & before(T1,T2) & ~reacquires(P,O,Q,T1,T2)) =>
         ~owns(P,O,Q,T2))).


% ============================================================
% SECTION 10 — ALLOWING
% ============================================================
thf(allows_decl, type, allows: en > en > en > tm > $o).
thf(allows_typing, axiom,
    ![P:en,O:en,Q:en,T:tm]:
        (allows(P,O,Q,T) => (is_owner(P,O,T) & person(Q) & (P!=Q)))).


% ============================================================
% SECTION 11 — VOLUNTARY TRANSFER
% ============================================================
thf(vol_transfer_decl, type, vol_transfer: en > en > en > tm > $o).
thf(vol_transfer_typing, axiom,
    ![P1:en,P2:en,O:en,T:tm]:
        (vol_transfer(P1,P2,O,T) => (is_owner(P1,O,T)&person(P2)&(P1!=P2)&np_obj(O)))).
thf(vol_transfer_disowns, axiom,
    ![P1:en,P2:en,O:en,Q:en,T:tm]:
        ((vol_transfer(P1,P2,O,T) & owns(P1,O,Q,T)) => disowns(P1,O,Q,T))).
thf(vol_transfer_grants, axiom,
    ![P1:en,P2:en,O:en,Q:en,T:tm]:
        ((vol_transfer(P1,P2,O,T) & person(Q) & (P2!=Q)) => owns(P2,O,Q,T))).


% ============================================================
% SECTION 12 — DEONTIC OPERATORS (KD + liberty)
% ============================================================
thf(ob_decl,  type, ob:  $o > $o).
thf(per_decl, type, per: $o > $o).
thf(for_decl, type, fbd: $o > $o).
thf(ob_implies_per,    axiom, ![Phi:$o]: (ob(Phi) => per(Phi))).
thf(deontic_consistency, axiom, ![Phi:$o]: ~(ob(Phi) & ob(~Phi))).
thf(forbidden_def,     axiom, ![Phi:$o]: (fbd(Phi) <=> ob(~Phi))).
thf(per_consistency,   axiom, ![Phi:$o]: (per(Phi) => ~ob(~Phi))).
thf(liberty,           axiom, ![Phi:$o]: (~fbd(Phi) => per(Phi))).


% ============================================================
% SECTION 13 — MANNER / CONFLICT LAYER
% excl(M1,M2): manners that cannot be jointly realised on a rivalrous O.
% excl_factual is PHYSICAL (not normative): it constrains which uses can
% co-occur, not which are permitted. wants/unrealised model intention
% and under-utilization.
% ============================================================
thf(excl_decl, type, excl: man > man > $o).
thf(excl_factual, axiom,
    ![O:en,P1:en,P2:en,M1:man,M2:man,T:tm]:
        ((rivalrous(O) & excl(M1,M2)) => ~(use(P1,O,M1,T) & use(P2,O,M2,T)))).

thf(wants_decl, type, wants: en > en > man > tm > $o).
thf(unrealised_decl, type, unrealised: en > en > man > tm > $o).
thf(unrealised_def, axiom,
    ![P:en,O:en,M:man,T:tm]: (unrealised(P,O,M,T) <=> (wants(P,O,M,T) & ~use(P,O,M,T)))).


% ============================================================
% SECTION 14 — NORMATIVE CONTENT
% ============================================================
% NAP (rivalrous-guarded, co-owner guard): unauthorized use of another's
% RIVALROUS property by a non-owner non-co-owner is forbidden.
thf(nap, axiom,
    ![P:en,O:en,Q:en,M:man,T:tm]:
        ((owns(P,O,Q,T) & rivalrous(O) & ~allows(P,O,Q,T) & ~is_owner(Q,O,T)) =>
         fbd(use(Q,O,M,T)))).

% An owner may use what they own, in any manner.
thf(owner_use_permitted, axiom,
    ![P:en,O:en,M:man,T:tm]: (is_owner(P,O,T) => per(use(P,O,M,T)))).

% Non-owner Q may use O only with ALL current owners' consent.
thf(allowed_use_permitted, axiom,
    ![O:en,Q:en,M:man,T:tm]:
        ((person(Q) & (np_obj(O)|person(O)) & ~is_owner(Q,O,T) &
          (![R:en]: (is_owner(R,O,T) => allows(R,O,Q,T)))) =>
         per(use(Q,O,M,T)))).

% Anyone may use a genuinely unowned np_obj.
thf(unowned_use_permitted, axiom,
    ![P:en,O:en,M:man,T:tm]:
        ((person(P)&np_obj(O)&unowned(O,T)) => per(use(P,O,M,T)))).

% Homesteading is permitted.
thf(homesteading_permitted, axiom,
    ![P:en,O:en,M:man,T:tm]:
        ((person(P)&np_obj(O)&use(P,O,M,T)&unowned(O,T)) => per(claim(P,O,T)))).

% Self-use is always permitted.
thf(self_use_permitted, axiom,
    ![P:en,M:man,T:tm]: (person(P) => per(use(P,P,M,T)))).

% Abandonment and transfer are permitted to an owner.
thf(abandonment_permitted, axiom,
    ![P:en,O:en,Q:en,T:tm]: ((is_owner(P,O,T)&np_obj(O)) => per(disowns(P,O,Q,T)))).
thf(transfer_permitted, axiom,
    ![P1:en,P2:en,O:en,T:tm]:
        ((is_owner(P1,O,T)&person(P2)&(P1!=P2)&np_obj(O)) => per(vol_transfer(P1,P2,O,T)))).


% ============================================================
% SECTION 15 — THEOREMS (all machine-proved; see ./minimal/)
% Role 'theorem': retained so Leo-III may reuse them as lemmas.
% ============================================================

thf(theft_forbidden, theorem,
    ![P:en,O:en,Q:en,M:man,T:tm]:
        ((owns(P,O,Q,T)&np_obj(O)&rivalrous(O)&~allows(P,O,Q,T)&~is_owner(Q,O,T)) =>
         fbd(use(Q,O,M,T)))).

thf(person_unownable, theorem,
    ![O:en,Q:en,T:tm]: ((person(O)&person(Q)&(O!=Q)) => ~is_owner(Q,O,T))).

thf(person_protection_prereqs, theorem,
    ![P:en,Q:en,T:tm]:
        ((person(P)&person(Q)&(P!=Q)) => (owns(P,P,Q,T) & ~is_owner(Q,P,T)))).

thf(nap_person, theorem,
    ![P:en,Q:en,M:man,T:tm]:
        ((person(P)&person(Q)&(P!=Q)&owns(P,P,Q,T)&~allows(P,P,Q,T)&~is_owner(Q,P,T)) =>
         fbd(use(Q,P,M,T)))).

thf(bodily_integrity, theorem,
    ![P:en,Q:en,M:man,T:tm]:
        ((person(P)&person(Q)&(P!=Q)&~allows(P,P,Q,T)) => fbd(use(Q,P,M,T)))).

thf(homesteader_is_owner_v2, theorem,
    ![P:en,O:en,M:man,T1:tm,T2:tm]:
        ((person(P)&np_obj(O)&use(P,O,M,T1)&claim(P,O,T1)&unowned(O,T1)&before(T1,T2)) =>
         is_owner(P,O,T2))).

thf(homesteader_may_use_v2, theorem,
    ![P:en,O:en,M:man,Mu:man,T1:tm,T2:tm]:
        ((person(P)&np_obj(O)&use(P,O,M,T1)&claim(P,O,T1)&unowned(O,T1)&before(T1,T2)) =>
         per(use(P,O,Mu,T2)))).

thf(voluntary_slavery_impossible, theorem,
    ![P1:en,P2:en,T:tm]:
        ((person(P1)&person(P2)&(P1!=P2)) => ~vol_transfer(P1,P2,P1,T))).

thf(theft_retains_ownership, theorem,
    ![P:en,O:en,Q:en,M:man,T:tm]:
        ((owns(P,O,Q,T)&np_obj(O)&~allows(P,O,Q,T)&use(Q,O,M,T)) => is_owner(P,O,T))).

thf(per_or_fbd, theorem,
    ![P:en,O:en,M:man,T:tm]: (per(use(P,O,M,T)) | fbd(use(P,O,M,T)))).

thf(nemo_dat, theorem,
    ![P1:en,P2:en,O:en,T:tm]: (vol_transfer(P1,P2,O,T) => is_owner(P1,O,T))).

% first_homesteader_exclusive_v2 — proved via the A/B/C/D split with the
% nodis frame atom (raw nested form times out; see CHANGELOG).
thf(first_homesteader_exclusive_v2, theorem,
    ![P:en,O:en,Q:en,M:man,T1:tm,T2:tm,T3:tm]:
        ((person(P)&np_obj(O)&use(P,O,M,T1)&claim(P,O,T1)&unowned(O,T1)&person(Q)&(P!=Q)&
          before(T1,T2)&before(T2,T3)&nodis(P,O,Q,T2,T3)) => ~unowned(O,T3))).

% transfer_exclusive — the transferor loses title (title-extinction).
thf(transfer_exclusive, theorem,
    ![P1:en,P2:en,O:en,Q:en,T:tm,T2:tm]:
        ((vol_transfer(P1,P2,O,T)&owns(P1,O,Q,T)&before(T,T2)&~reacquires(P1,O,Q,T,T2)) =>
         ~owns(P1,O,Q,T2))).

% --- Rivalrousness / joint-ownership theorems (general form) ---

% Co-owners with clashing exclusive manners: each is permitted their
% manner, the two uses are not jointly realisable, and NO contradiction
% arises. The deontic layer (per) and the physical layer (excl_factual)
% do not collide.
thf(joint_conflict_no_contradiction, theorem,
    ![A:en,B:en,O:en,M1:man,M2:man,T:tm]:
        ((person(A)&person(B)&(A!=B)&np_obj(O)&rivalrous(O)&
          owns(A,O,B,T)&owns(B,O,A,T)&is_owner(A,O,T)&is_owner(B,O,T)&excl(M1,M2)) =>
         ( per(use(A,O,M1,T)) & per(use(B,O,M2,T)) &
           ~(use(A,O,M1,T) & use(B,O,M2,T)) ))).

% Conflicting intentions yield UNDER-UTILIZATION: at least one intended
% use is unrealised, while both co-owners remain permitted. A coordination
% loss, not a logical contradiction.
thf(under_utilization, theorem,
    ![A:en,B:en,O:en,M1:man,M2:man,T:tm]:
        ((person(A)&person(B)&(A!=B)&np_obj(O)&rivalrous(O)&
          is_owner(A,O,T)&is_owner(B,O,T)&excl(M1,M2)&
          wants(A,O,M1,T)&wants(B,O,M2,T)) =>
         ( per(use(A,O,M1,T)) & per(use(B,O,M2,T)) &
           (unrealised(A,O,M1,T) | unrealised(B,O,M2,T)) ))).


% ============================================================
% SECTION 16 — ROADMAP CONJECTURES (see ROADMAP.md)
% ============================================================
% Object-relative exclusivity:        excl_o(O,M1,M2)
% Abandonment -> res nullius (B5):     uses disown_extinguishes
% Strong NAP (ownership sole basis):   fbd(use) => exists owner ...
% Exclusion-primitive refactor:        owns defined from right_to_exclude
% Non-rivalrous use permitted (IP):    ~rivalrous(O) => per(use(Q,O,M,T))
% Sublicensing:                        sub_allows(Q,O,R,T)
% Consistency witness:                 Nitpick/Paradox finite model
% ============================================================

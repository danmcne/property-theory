thf(tm_sort,type,tm:$tType). thf(en_sort,type,en:$tType). thf(man_sort,type,man:$tType).
thf(person_decl,type,person:en>$o). thf(np_obj_decl,type,np_obj:en>$o). thf(is_owner_decl,type,is_owner:en>en>tm>$o).
thf(consents_decl,type,consents:en>en>en>man>tm>$o).
thf(may_use_decl,type,may_use:en>en>man>tm>$o). thf(forbidden_use_decl,type,forbidden_use:en>en>man>tm>$o).
thf(use_grant,axiom,![Q:en,O:en,M:man,T:tm]:
  (((person(Q)&(np_obj(O)|person(O)))&(![R:en]:(is_owner(R,O,T)=>consents(R,O,Q,M,T))))=>may_use(Q,O,M,T))).
thf(use_veto,axiom,![R:en,O:en,Q:en,M:man,T:tm]:((is_owner(R,O,T)&~consents(R,O,Q,M,T))=>forbidden_use(Q,O,M,T))).
thf(sole_owner_grant, conjecture, ![Q:en,O:en,P:en,M:man,T:tm]:
  ((person(Q)&(np_obj(O)|person(O))&is_owner(P,O,T)&(![R:en]:(is_owner(R,O,T)=>(R=P)))&consents(P,O,Q,M,T))
   => may_use(Q,O,M,T))).

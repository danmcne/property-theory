thf(tm_sort,type,tm:$tType). thf(en_sort,type,en:$tType). thf(man_sort,type,man:$tType).
thf(before_decl,type,before:tm>tm>$o). thf(person_decl,type,person:en>$o). thf(np_obj_decl,type,np_obj:en>$o). thf(use_decl,type,use:en>en>man>tm>$o). thf(claim_decl,type,claim:en>en>tm>$o). thf(unowned_decl,type,unowned:en>tm>$o). thf(owns_decl,type,owns:en>en>en>tm>$o). thf(is_owner_decl,type,is_owner:en>en>tm>$o).
thf(nodis_decl,type,nodis:en>en>en>tm>tm>$o).
thf(homesteader_owns_v2, theorem,
  ![P:en,O:en,Q:en,M:man,T1:tm,T2:tm]:
    ((person(P)&np_obj(O)&use(P,O,M,T1)&claim(P,O,T1)&unowned(O,T1)&person(Q)&(P!=Q)&before(T1,T2)) => owns(P,O,Q,T2))).
thf(ownership_persistence, axiom,
  ![P:en,O:en,Q:en,T1:tm,T2:tm]: ((owns(P,O,Q,T1)&before(T1,T2)&nodis(P,O,Q,T1,T2)) => owns(P,O,Q,T2))).
thf(persistence_from_homestead, conjecture,
  ![P:en,O:en,Q:en,M:man,T1:tm,T2:tm,T3:tm]:
    ((person(P)&np_obj(O)&use(P,O,M,T1)&claim(P,O,T1)&unowned(O,T1)&person(Q)&(P!=Q)&before(T1,T2)&before(T2,T3)&nodis(P,O,Q,T2,T3)) => owns(P,O,Q,T3))).

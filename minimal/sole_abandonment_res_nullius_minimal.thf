thf(tm_sort,type,tm:$tType). thf(en_sort,type,en:$tType). thf(man_sort,type,man:$tType).
thf(person_decl,type,person:en>$o). thf(np_obj_decl,type,np_obj:en>$o).
thf(before_decl,type,before:tm>tm>$o).
thf(owns_decl,type,owns:en>en>en>tm>$o). thf(is_owner_decl,type,is_owner:en>en>tm>$o). thf(unowned_decl,type,unowned:en>tm>$o).
thf(disowns_decl,type,disowns:en>en>en>tm>$o). thf(reacquires_decl,type,reacquires:en>en>en>tm>tm>$o).
thf(abandons_decl,type,abandons:en>en>tm>$o).
thf(owns_typing,axiom,![P:en,O:en,Q:en,T:tm]:(owns(P,O,Q,T)=>(person(P)&(np_obj(O)|(O=P))&person(Q)&(P!=Q)))).
thf(is_owner_def,axiom,![P:en,O:en,T:tm]:(is_owner(P,O,T)<=> ?[Q:en]:owns(P,O,Q,T))).
thf(unowned_def,axiom,![O:en,T:tm]:(unowned(O,T)<=> ![P:en]:~is_owner(P,O,T))).
thf(disown_extinguishes,axiom,![P:en,O:en,Q:en,T1:tm,T2:tm]:((disowns(P,O,Q,T1)&before(T1,T2)&~reacquires(P,O,Q,T1,T2))=>~owns(P,O,Q,T2))).
% NEW: abandonment = a sole/standing owner relinquishing against EVERY other party
thf(abandons_def,axiom,![P:en,O:en,T:tm]:
  (abandons(P,O,T) <=> (np_obj(O)&is_owner(P,O,T)&(![Q:en]:((person(Q)&(P!=Q))=>disowns(P,O,Q,T)))))).
thf(lem_abandoner_not_owner, axiom, ![P:en,O:en,T1:tm,T2:tm]:
  ((np_obj(O)&before(T1,T2)&abandons(P,O,T1)&(![Q:en]:~reacquires(P,O,Q,T1,T2))) => ~is_owner(P,O,T2))).
thf(sole_abandonment_res_nullius, conjecture, ![P:en,O:en,T1:tm,T2:tm]:
  ((np_obj(O)&is_owner(P,O,T1)&(![R:en]:(is_owner(R,O,T1)=>(R=P)))
    &before(T1,T2)&abandons(P,O,T1)&(![Q:en]:~reacquires(P,O,Q,T1,T2))
    &(![R:en]:((R!=P)=>~is_owner(R,O,T2))))
   => unowned(O,T2))).

thf(tm_sort,type,tm:$tType). thf(en_sort,type,en:$tType). thf(man_sort,type,man:$tType).
thf(use_decl,type,use:en>en>man>tm>$o). thf(per_decl,type,per:$o>$o). thf(fbd_decl,type,fbd:$o>$o).

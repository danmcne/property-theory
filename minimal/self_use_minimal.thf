thf(tm_sort,type,tm:$tType). thf(en_sort,type,en:$tType). thf(man_sort,type,man:$tType).
thf(person_decl,type,person:en>$o). thf(np_obj_decl,type,np_obj:en>$o). thf(is_owner_decl,type,is_owner:en>en>tm>$o).
thf(consents_decl,type,consents:en>en>en>man>tm>$o).
thf(may_use_decl,type,may_use:en>en>man>tm>$o). thf(forbidden_use_decl,type,forbidden_use:en>en>man>tm>$o).
thf(lem_sole_owner_grant,axiom,![Q:en,O:en,P:en,M:man,T:tm]:((person(Q)&(np_obj(O)|person(O))&is_owner(P,O,T)&(![R:en]:(is_owner(R,O,T)=>(R=P)))&consents(P,O,Q,M,T))=>may_use(Q,O,M,T))).
thf(lem_use_veto,axiom,![R:en,O:en,Q:en,M:man,T:tm]:((is_owner(R,O,T)&~consents(R,O,Q,M,T))=>forbidden_use(Q,O,M,T))).
thf(lem_self_consent,axiom,![P:en,O:en,M:man,T:tm]:(is_owner(P,O,T)=>consents(P,O,P,M,T))).
thf(lem_self_is_owner,axiom,![P:en,T:tm]:(person(P)=>is_owner(P,P,T))).
thf(lem_body_sole_owner,axiom,![P:en,R:en,T:tm]:((person(P)&is_owner(R,P,T))=>(R=P))).
thf(self_use,conjecture,![P:en,M:man,T:tm]:(person(P)=>may_use(P,P,M,T))).

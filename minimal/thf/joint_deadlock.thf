% LEMMA (proved in its own problem): If someone who holds a title against you over a thing does not consent, your use is forbidden (unless he is aggressing against you at that instant).
thf(theft_forbidden, axiom,
    ![R:en,O:en,Q:en,M:man,T:tm]: ((owns(R,O,Q,M,T) & ~ consents(R,O,Q,M,T) & ~ aggresses(R,Q,T)) => forbidden_use(Q,O,M,T))).
thf(joint_deadlock, conjecture,
    ![A:en,B:en,O:en,M1:man,M2:man,T:tm]: ((owns(A,O,B,M2,T) & owns(B,O,A,M1,T) & ~ consents(A,O,B,M2,T) & ~ consents(B,O,A,M1,T) & ~ aggresses(A,B,T) & ~ aggresses(B,A,T)) => (forbidden_use(A,O,M1,T) & forbidden_use(B,O,M2,T)))).

% LEMMA (proved in its own problem): Homesteading makes the homesteader a full owner: he may exclude everyone else from every use.
thf(homesteader_full_owner, axiom,
    ![P:en,O:en,M2:man,T1:tm,T2:tm]: ((rivalrous(O) & use(P,O,M2,T1) & claim(P,O,T1) & unowned(O,T1) & before(T1,T2) & ![Q:en,M:man]: nodis_upto(P,O,Q,M,T1,T2)) => full_owner(P,O,T2))).
thf(joint_homesteading, conjecture,
    ![A:en,B:en,O:en,M1:man,M2:man,T1:tm,T2:tm]: ((rivalrous(O) & use(A,O,M1,T1) & claim(A,O,T1) & use(B,O,M2,T1) & claim(B,O,T1) & unowned(O,T1) & before(T1,T2) & ![Q:en,M:man]: (nodis_upto(A,O,Q,M,T1,T2) & nodis_upto(B,O,Q,M,T1,T2))) => (full_owner(A,O,T2) & full_owner(B,O,T2)))).

% Libertarian Property Theory v0.23 -- minimal problem for: control_needs_deference
% A co-owner controls the thing only if every other person who may exclude him consents to every use he makes. A co-owner whose wish for idleness prevails does not thereby control the thing.
% Generated by source/build.py from source/theory.py. Do not edit.
thf(tm_type, type, tm: $tType).
thf(en_type, type, en: $tType).
thf(man_type, type, man: $tType).
thf(aggresses_decl, type, aggresses: en > en > tm > $o).
thf(aggresses_in_decl, type, aggresses_in: en > en > man > tm > $o).
thf(consents_decl, type, consents: en > en > en > man > tm > $o).
thf(controls_decl, type, controls: en > en > tm > $o).
thf(forfeits_decl, type, forfeits: en > en > en > tm > $o).
thf(may_use_decl, type, may_use: en > en > man > tm > $o).
thf(owns_decl, type, owns: en > en > en > man > tm > $o).
thf(person_decl, type, person: en > $o).
thf(use_decl, type, use: en > en > man > tm > $o).
% P controls O when P may use O in every manner and every other person may use O exactly when P consents.
thf(controls_def, axiom,
    ![P:en,O:en,T:tm]: (controls(P,O,T) <=> (![M:man]: may_use(P,O,M,T) & ![Q:en,M:man]: ((person(Q) & (Q != P)) => (may_use(Q,O,M,T) <=> consents(P,O,Q,M,T)))))).
% Q may use O in manner M unless someone who holds a title against Q over O in M, and has not forfeited it, does not consent.
thf(may_use_def, axiom,
    ![Q:en,O:en,M:man,T:tm]: (may_use(Q,O,M,T) <=> ![R:en]: ((owns(R,O,Q,M,T) & ~ forfeits(R,O,Q,T)) => consents(R,O,Q,M,T)))).
% While R aggresses against Q, R forfeits, with respect to Q, his titles over his own body and over the things he uses in the aggressing action. Q may use them without R's consent.
thf(forfeits_def, axiom,
    ![R:en,O:en,Q:en,T:tm]: (forfeits(R,O,Q,T) <=> ?[M:man]: (aggresses_in(R,Q,M,T) & ((O = R) | use(R,O,M,T))))).
% P aggresses against Q when some action of P aggresses against Q.
thf(aggresses_def, axiom,
    ![P:en,Q:en,T:tm]: (aggresses(P,Q,T) <=> ?[M:man]: aggresses_in(P,Q,M,T))).
thf(control_needs_deference, conjecture,
    ![A:en,B:en,O:en,M:man,T:tm]: ((controls(A,O,T) & owns(B,O,A,M,T) & ~ aggresses(B,A,T)) => consents(B,O,A,M,T))).

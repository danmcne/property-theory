% Libertarian Property Theory v0.23 -- minimal problem for: transferor_not_owner
% After a transfer the former owner holds no title over the thing, unless he acquires one again.
% Generated by source/build.py from source/theory.py. Do not edit.
thf(tm_type, type, tm: $tType).
thf(en_type, type, en: $tType).
thf(man_type, type, man: $tType).
thf(abandons_decl, type, abandons: en > en > tm > $o).
thf(acquires_decl, type, acquires: en > en > en > man > tm > $o).
thf(before_decl, type, before: tm > tm > $o).
thf(is_owner_decl, type, is_owner: en > en > tm > $o).
thf(vol_transfer_decl, type, vol_transfer: en > en > en > tm > $o).
% LEMMA (proved in its own problem): A transfer is an abandonment in favour of a named person.
thf(transfer_is_abandonment, axiom,
    ![P1:en,P2:en,O:en,T:tm]: (vol_transfer(P1,P2,O,T) => abandons(P1,O,T))).
% LEMMA (proved in its own problem): Whoever abandons a thing holds no title over it afterwards, unless he acquires one again.
thf(abandoner_not_owner, axiom,
    ![P:en,O:en,T1:tm,T2:tm]: ((abandons(P,O,T1) & before(T1,T2) & ![Q:en,M:man,T:tm]: ((((T = T1) | before(T1,T)) & before(T,T2)) => ~ acquires(P,O,Q,M,T))) => ~ is_owner(P,O,T2))).
thf(transferor_not_owner, conjecture,
    ![P1:en,P2:en,O:en,T1:tm,T2:tm]: ((vol_transfer(P1,P2,O,T1) & before(T1,T2) & ![Q:en,M:man,T:tm]: ((((T = T1) | before(T1,T)) & before(T,T2)) => ~ acquires(P1,O,Q,M,T))) => ~ is_owner(P1,O,T2))).

% Libertarian Property Theory v0.23 -- minimal problem for: co_owner_use_by_consent
% A co-owner may use the common thing when the only other person who may exclude him consents.
% Generated by source/build.py from source/theory.py. Do not edit.
thf(tm_type, type, tm: $tType).
thf(en_type, type, en: $tType).
thf(man_type, type, man: $tType).
thf(consents_decl, type, consents: en > en > en > man > tm > $o).
thf(forfeits_decl, type, forfeits: en > en > en > tm > $o).
thf(may_use_decl, type, may_use: en > en > man > tm > $o).
thf(owns_decl, type, owns: en > en > en > man > tm > $o).
% Q may use O in manner M unless someone who holds a title against Q over O in M, and has not forfeited it, does not consent.
thf(may_use_def, axiom,
    ![Q:en,O:en,M:man,T:tm]: (may_use(Q,O,M,T) <=> ![R:en]: ((owns(R,O,Q,M,T) & ~ forfeits(R,O,Q,T)) => consents(R,O,Q,M,T)))).
thf(co_owner_use_by_consent, conjecture,
    ![A:en,B:en,O:en,M:man,T:tm]: ((owns(B,O,A,M,T) & consents(B,O,A,M,T) & ![R:en]: (owns(R,O,A,M,T) => (R = B))) => may_use(A,O,M,T))).

% Libertarian Property Theory v0.23 -- minimal problem for: derived_persons_rivalrous
% Redundancy check: Every body is scarce: some two uses of it clash.
% Generated by source/build.py from source/theory.py. Do not edit.
thf(tm_type, type, tm: $tType).
thf(en_type, type, en: $tType).
thf(man_type, type, man: $tType).
thf(is_owner_decl, type, is_owner: en > en > tm > $o).
thf(owns_decl, type, owns: en > en > en > man > tm > $o).
thf(person_decl, type, person: en > $o).
thf(rivalrous_decl, type, rivalrous: en > $o).
thf(unowned_decl, type, unowned: en > tm > $o).
% Every person holds a title over his or her body against every other person, in every manner, at every instant.
thf(self_ownership, axiom,
    ![P:en,Q:en,M:man,T:tm]: ((person(P) & person(Q) & (P != Q)) => owns(P,P,Q,M,T))).
% Things that are not scarce (ideas, patterns) are never owned.
thf(nonrivalrous_unowned, axiom,
    ![O:en,T:tm]: (~ rivalrous(O) => unowned(O,T))).
% There are at least two persons.
thf(two_persons, axiom,
    ?[P1:en,P2:en]: (person(P1) & person(P2) & (P1 != P2))).
% A holder of rights over O is someone who holds at least one title over O.
thf(is_owner_def, axiom,
    ![P:en,O:en,T:tm]: (is_owner(P,O,T) <=> ?[Q:en,M:man]: owns(P,O,Q,M,T))).
% O is unowned when nobody holds any title over it.
thf(unowned_def, axiom,
    ![O:en,T:tm]: (unowned(O,T) <=> ![P:en]: ~ is_owner(P,O,T))).
thf(derived_persons_rivalrous, conjecture,
    ![P:en]: (person(P) => rivalrous(P))).

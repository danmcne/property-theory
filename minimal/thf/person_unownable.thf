% Libertarian Property Theory v0.23 -- minimal problem for: person_unownable
% Nobody holds a title over another person (no slavery).
% Generated by source/build.py from source/theory.py. Do not edit.
thf(tm_type, type, tm: $tType).
thf(en_type, type, en: $tType).
thf(man_type, type, man: $tType).
thf(np_obj_decl, type, np_obj: en > $o).
thf(owns_decl, type, owns: en > en > en > man > tm > $o).
thf(person_decl, type, person: en > $o).
% A title is held by a person against another person, over an object or the holder's own body.
thf(owns_typing, axiom,
    ![P:en,O:en,Q:en,M:man,T:tm]: (owns(P,O,Q,M,T) => (person(P) & person(Q) & (P != Q) & (np_obj(O) | (O = P))))).
% Nothing is both a person and an object.
thf(entity_disjoint, axiom,
    ![X:en]: ~ (person(X) & np_obj(X))).
thf(person_unownable, conjecture,
    ![P:en,O:en,Q:en,M:man,T:tm]: ((person(O) & (P != O)) => ~ owns(P,O,Q,M,T))).

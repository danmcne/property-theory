% Libertarian Property Theory v0.23 -- minimal problem for: ownership_is_not_licence
% Your fist ends where my nose begins: P may use his own knife, but an action that also uses R's property without R's consent is aggression, and is not permissible.
% Generated by source/build.py from source/theory.py. Do not edit.
thf(tm_type, type, tm: $tType).
thf(en_type, type, en: $tType).
thf(man_type, type, man: $tType).
thf(aggresses_decl, type, aggresses: en > en > tm > $o).
thf(aggresses_in_decl, type, aggresses_in: en > en > man > tm > $o).
thf(consents_decl, type, consents: en > en > en > man > tm > $o).
thf(forbidden_use_decl, type, forbidden_use: en > en > man > tm > $o).
thf(forfeits_decl, type, forfeits: en > en > en > tm > $o).
thf(may_use_decl, type, may_use: en > en > man > tm > $o).
thf(owns_decl, type, owns: en > en > en > man > tm > $o).
thf(permissible_decl, type, permissible: en > man > tm > $o).
thf(use_decl, type, use: en > en > man > tm > $o).
% An action is permissible when each thing it uses may be used in that manner.
thf(permissible_def, axiom,
    ![P:en,M:man,T:tm]: (permissible(P,M,T) <=> ![O:en]: (use(P,O,M,T) => may_use(P,O,M,T)))).
% A use is forbidden exactly when it is not permitted.
thf(forbidden_use_def, axiom,
    ![Q:en,O:en,M:man,T:tm]: (forbidden_use(Q,O,M,T) <=> ~ may_use(Q,O,M,T))).
% P aggresses against Q when some action of P aggresses against Q.
thf(aggresses_def, axiom,
    ![P:en,Q:en,T:tm]: (aggresses(P,Q,T) <=> ?[M:man]: aggresses_in(P,Q,M,T))).
% P's action in manner M aggresses against Q when it uses something over which Q holds an unforfeited title against P in M, without Q's consent.
thf(aggresses_in_def, axiom,
    ![P:en,Q:en,M:man,T:tm]: (aggresses_in(P,Q,M,T) <=> ?[O:en]: (use(P,O,M,T) & owns(Q,O,P,M,T) & ~ forfeits(Q,O,P,T) & ~ consents(Q,O,P,M,T)))).
% While R aggresses against Q, R forfeits, with respect to Q, his titles over his own body and over the things he uses in the aggressing action. Q may use them without R's consent.
thf(forfeits_def, axiom,
    ![R:en,O:en,Q:en,T:tm]: (forfeits(R,O,Q,T) <=> ?[M:man]: (aggresses_in(R,Q,M,T) & ((O = R) | use(R,O,M,T))))).
% LEMMA (proved in its own problem): If nobody holds a title against you over a thing in a manner, you may use it in that manner. Ownership is not needed for use.
thf(unexcluded_use, axiom,
    ![Q:en,O:en,M:man,T:tm]: (![R:en]: ~ owns(R,O,Q,M,T) => may_use(Q,O,M,T))).
% LEMMA (proved in its own problem): If someone who holds a title against you over a thing does not consent, your use is forbidden (unless he is aggressing against you at that instant).
thf(theft_forbidden, axiom,
    ![R:en,O:en,Q:en,M:man,T:tm]: ((owns(R,O,Q,M,T) & ~ consents(R,O,Q,M,T) & ~ aggresses(R,Q,T)) => forbidden_use(Q,O,M,T))).
thf(ownership_is_not_licence, conjecture,
    ![P:en,R:en,O1:en,O2:en,M:man,T:tm]: ((![S:en]: ~ owns(S,O1,P,M,T) & use(P,O1,M,T) & use(P,O2,M,T) & owns(R,O2,P,M,T) & ~ consents(R,O2,P,M,T) & ~ aggresses(R,P,T)) => (may_use(P,O1,M,T) & aggresses(P,R,T) & ~ permissible(P,M,T)))).

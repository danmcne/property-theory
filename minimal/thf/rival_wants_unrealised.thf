% Libertarian Property Theory v0.23 -- minimal problem for: rival_wants_unrealised
% When one person uses a scarce thing, a second person who wants a clashing use cannot have it: conflict is possible, which is why titles are needed.
% Generated by source/build.py from source/theory.py. Do not edit.
thf(tm_type, type, tm: $tType).
thf(en_type, type, en: $tType).
thf(man_type, type, man: $tType).
thf(clash_decl, type, clash: en > man > man > $o).
thf(unrealised_decl, type, unrealised: en > en > man > tm > $o).
thf(use_decl, type, use: en > en > man > tm > $o).
thf(wants_decl, type, wants: en > en > man > tm > $o).
% Two different use events in clashing manners do not happen at the same instant.
thf(clash_factual, axiom,
    ![O:en,P1:en,P2:en,M1:man,M2:man,T:tm]: ((clash(O,M1,M2) & ~ ((P1 = P2) & (M1 = M2))) => ~ (use(P1,O,M1,T) & use(P2,O,M2,T)))).
% A want is unrealised when the wanted use does not happen.
thf(unrealised_def, axiom,
    ![P:en,O:en,M:man,T:tm]: (unrealised(P,O,M,T) <=> (wants(P,O,M,T) & ~ use(P,O,M,T)))).
thf(rival_wants_unrealised, conjecture,
    ![O:en,P1:en,P2:en,M1:man,M2:man,T:tm]: ((clash(O,M1,M2) & (P1 != P2) & use(P1,O,M1,T) & wants(P2,O,M2,T)) => unrealised(P2,O,M2,T))).

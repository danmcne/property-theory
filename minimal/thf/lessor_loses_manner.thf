% Libertarian Property Theory v0.23 -- minimal problem for: lessor_loses_manner
% During a lease of manner M the landlord holds no title in manner M (unless he acquires one again). His titles in the other manners are untouched.
% Generated by source/build.py from source/theory.py. Do not edit.
thf(tm_type, type, tm: $tType).
thf(en_type, type, en: $tType).
thf(man_type, type, man: $tType).
thf(acquires_decl, type, acquires: en > en > en > man > tm > $o).
thf(before_decl, type, before: tm > tm > $o).
thf(disowns_decl, type, disowns: en > en > en > man > tm > $o).
thf(grants_decl, type, grants: en > en > en > en > man > tm > $o).
thf(is_owner_decl, type, is_owner: en > en > tm > $o).
thf(np_obj_decl, type, np_obj: en > $o).
thf(owns_decl, type, owns: en > en > en > man > tm > $o).
thf(person_decl, type, person: en > $o).
thf(shares_decl, type, shares: en > en > en > man > tm > $o).
thf(transfers_manner_decl, type, transfers_manner: en > en > en > man > tm > $o).
% R transfers manner M of O to P: R shares manner M with P and releases all his titles in M. A lease is such a transfer for the leased manners.
thf(transfers_manner_def, axiom,
    ![R:en,P:en,O:en,M:man,T:tm]: (transfers_manner(R,P,O,M,T) <=> (shares(R,P,O,M,T) & ![Q:en]: (owns(R,O,Q,M,T) => disowns(R,O,Q,M,T))))).
% R shares manner M of O with P: R grants P every title in M that R holds, and a title in M against R himself.
thf(shares_def, axiom,
    ![R:en,P:en,O:en,M:man,T:tm]: (shares(R,P,O,M,T) <=> (grants(R,P,O,R,M,T) & ![Q:en]: ((owns(R,O,Q,M,T) & (Q != P)) => grants(R,P,O,Q,M,T))))).
% Only an owner grants, only titles over an object, and only to another person.
thf(grant_typing, axiom,
    ![R:en,P:en,O:en,Q:en,M:man,T:tm]: (grants(R,P,O,Q,M,T) => (is_owner(R,O,T) & np_obj(O) & person(P) & (R != P)))).
% No instant is before itself.
thf(time_irreflexive, axiom,
    ![T:tm]: ~ before(T,T)).
% If A is before B and B is before C, then A is before C.
thf(time_transitive, axiom,
    ![A:tm,B:tm,C:tm]: ((before(A,B) & before(B,C)) => before(A,C))).
% Any two instants are equal or one is before the other.
thf(time_total, axiom,
    ![A:tm,B:tm]: (before(A,B) | before(B,A) | (A = B))).
% LEMMA (proved in its own problem): A released title stays released unless a new acquisition event happens.
thf(disown_extinguishes, axiom,
    ![P:en,O:en,Q:en,M:man,T1:tm,T2:tm]: ((disowns(P,O,Q,M,T1) & before(T1,T2) & ![T:tm]: ((before(T1,T) & before(T,T2)) => ~ acquires(P,O,Q,M,T))) => ~ owns(P,O,Q,M,T2))).
% LEMMA (proved in its own problem): A title not held at T1 is not held at T2 unless an acquisition event happens in between.
thf(no_fresh_title, axiom,
    ![P:en,O:en,Q:en,M:man,T1:tm,T2:tm]: ((np_obj(O) & ~ owns(P,O,Q,M,T1) & before(T1,T2) & ![T:tm]: ((((T = T1) | before(T1,T)) & before(T,T2)) => ~ acquires(P,O,Q,M,T))) => ~ owns(P,O,Q,M,T2))).
thf(lessor_loses_manner, conjecture,
    ![L:en,N:en,O:en,M:man,T1:tm,T2:tm]: ((transfers_manner(L,N,O,M,T1) & before(T1,T2) & ![Q:en,T:tm]: ((((T = T1) | before(T1,T)) & before(T,T2)) => ~ acquires(L,O,Q,M,T))) => ![Q:en]: ~ owns(L,O,Q,M,T2))).

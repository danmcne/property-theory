% Libertarian Property Theory v0.23 -- minimal problem for: direction_forbids_deadlock
% With LiquidZulu's premise, co-owners who refuse each other can never want clashing uses: the premise rules out exactly the outcome in which neither co-owner may proceed without the other.
% Generated by source/build.py from source/theory.py. Do not edit.
thf(tm_type, type, tm: $tType).
thf(en_type, type, en: $tType).
thf(man_type, type, man: $tType).
thf(aggresses_decl, type, aggresses: en > en > tm > $o).
thf(clash_decl, type, clash: en > man > man > $o).
thf(consents_decl, type, consents: en > en > en > man > tm > $o).
thf(forbidden_use_decl, type, forbidden_use: en > en > man > tm > $o).
thf(is_owner_decl, type, is_owner: en > en > tm > $o).
thf(may_use_decl, type, may_use: en > en > man > tm > $o).
thf(owns_decl, type, owns: en > en > en > man > tm > $o).
thf(person_decl, type, person: en > $o).
thf(wants_decl, type, wants: en > en > man > tm > $o).
% CONTRAST axiom (control view): Direction view (LiquidZulu): a conflict between two owners of a thing over its use has a just victor, whose use is permitted while the other's is forbidden.
thf(direction_exhaustive, axiom,
    ![A:en,B:en,O:en,M1:man,M2:man,T:tm]: ((person(A) & person(B) & (A != B) & is_owner(A,O,T) & is_owner(B,O,T) & wants(A,O,M1,T) & wants(B,O,M2,T) & clash(O,M1,M2)) => ((may_use(A,O,M1,T) & forbidden_use(B,O,M2,T)) | (may_use(B,O,M2,T) & forbidden_use(A,O,M1,T))))).
% A use is forbidden exactly when it is not permitted.
thf(forbidden_use_def, axiom,
    ![Q:en,O:en,M:man,T:tm]: (forbidden_use(Q,O,M,T) <=> ~ may_use(Q,O,M,T))).
% A holder of rights over O is someone who holds at least one title over O.
thf(is_owner_def, axiom,
    ![P:en,O:en,T:tm]: (is_owner(P,O,T) <=> ?[Q:en,M:man]: owns(P,O,Q,M,T))).
% LEMMA (proved in its own problem): If someone who holds a title against you over a thing does not consent, your use is forbidden (unless he is aggressing against you at that instant).
thf(theft_forbidden, axiom,
    ![R:en,O:en,Q:en,M:man,T:tm]: ((owns(R,O,Q,M,T) & ~ consents(R,O,Q,M,T) & ~ aggresses(R,Q,T)) => forbidden_use(Q,O,M,T))).
thf(direction_forbids_deadlock, conjecture,
    ![A:en,B:en,O:en,M1:man,M2:man,T:tm]: ~ (person(A) & person(B) & (A != B) & owns(A,O,B,M2,T) & owns(B,O,A,M1,T) & ~ consents(A,O,B,M2,T) & ~ consents(B,O,A,M1,T) & ~ aggresses(A,B,T) & ~ aggresses(B,A,T) & wants(A,O,M1,T) & wants(B,O,M2,T) & clash(O,M1,M2))).

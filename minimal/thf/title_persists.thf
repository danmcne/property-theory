% Libertarian Property Theory v0.23 -- minimal problem for: title_persists
% A title lasts until it is released.
% Generated by source/build.py from source/theory.py. Do not edit.
thf(tm_type, type, tm: $tType).
thf(en_type, type, en: $tType).
thf(man_type, type, man: $tType).
thf(acquires_decl, type, acquires: en > en > en > man > tm > $o).
thf(before_decl, type, before: tm > tm > $o).
thf(disowns_decl, type, disowns: en > en > en > man > tm > $o).
thf(nodis_upto_decl, type, nodis_upto: en > en > en > man > tm > tm > $o).
thf(np_obj_decl, type, np_obj: en > $o).
thf(owns_decl, type, owns: en > en > en > man > tm > $o).
thf(person_decl, type, person: en > $o).
% A title over an object holds only because of an earlier acquisition event that was not released since.
thf(title_genesis, axiom,
    ![P:en,O:en,Q:en,M:man,T2:tm]: ((owns(P,O,Q,M,T2) & np_obj(O)) => ?[T1:tm]: (before(T1,T2) & acquires(P,O,Q,M,T1) & nodis_upto(P,O,Q,M,T1,T2)))).
% After an acquisition event, the title holds at every later instant until it is released.
thf(title_acquired, axiom,
    ![P:en,O:en,Q:en,M:man,T1:tm,T2:tm]: ((acquires(P,O,Q,M,T1) & person(Q) & (P != Q) & before(T1,T2) & nodis_upto(P,O,Q,M,T1,T2)) => owns(P,O,Q,M,T2))).
% The title of P against Q over O in manner M is not released in the window [T1,T2).
thf(nodis_upto_def, axiom,
    ![P:en,O:en,Q:en,M:man,T1:tm,T2:tm]: (nodis_upto(P,O,Q,M,T1,T2) <=> ![T:tm]: ((((T = T1) | before(T1,T)) & before(T,T2)) => ~ disowns(P,O,Q,M,T)))).
% A title is held by a person against another person, over an object or the holder's own body.
thf(owns_typing, axiom,
    ![P:en,O:en,Q:en,M:man,T:tm]: (owns(P,O,Q,M,T) => (person(P) & person(Q) & (P != Q) & (np_obj(O) | (O = P))))).
% No instant is before itself.
thf(time_irreflexive, axiom,
    ![T:tm]: ~ before(T,T)).
% If A is before B and B is before C, then A is before C.
thf(time_transitive, axiom,
    ![A:tm,B:tm,C:tm]: ((before(A,B) & before(B,C)) => before(A,C))).
% Any two instants are equal or one is before the other.
thf(time_total, axiom,
    ![A:tm,B:tm]: (before(A,B) | before(B,A) | (A = B))).
thf(title_persists, conjecture,
    ![P:en,O:en,Q:en,M:man,T1:tm,T2:tm]: ((owns(P,O,Q,M,T1) & np_obj(O) & before(T1,T2) & nodis_upto(P,O,Q,M,T1,T2)) => owns(P,O,Q,M,T2))).

% Libertarian Property Theory v0.23 -- minimal problem for: life_cycle
% Full cycle: an abandoned thing can be homesteaded again by anyone, the former owner included.
% Generated by source/build.py from source/theory.py. Do not edit.
thf(tm_type, type, tm: $tType).
thf(en_type, type, en: $tType).
thf(man_type, type, man: $tType).
thf(abandons_decl, type, abandons: en > en > tm > $o).
thf(acquires_decl, type, acquires: en > en > en > man > tm > $o).
thf(before_decl, type, before: tm > tm > $o).
thf(claim_decl, type, claim: en > en > tm > $o).
thf(is_owner_decl, type, is_owner: en > en > tm > $o).
thf(nodis_upto_decl, type, nodis_upto: en > en > en > man > tm > tm > $o).
thf(owns_decl, type, owns: en > en > en > man > tm > $o).
thf(person_decl, type, person: en > $o).
thf(rivalrous_decl, type, rivalrous: en > $o).
thf(unowned_decl, type, unowned: en > tm > $o).
thf(use_decl, type, use: en > en > man > tm > $o).
% LEMMA (proved in its own problem): When the only owner abandons a thing and nobody acquires it meanwhile, it becomes unowned again.
thf(res_nullius, axiom,
    ![P:en,O:en,T1:tm,T2:tm]: ((abandons(P,O,T1) & ![R:en]: (is_owner(R,O,T1) => (R = P)) & before(T1,T2) & ![R:en,Q:en,M:man,T:tm]: ((((T = T1) | before(T1,T)) & before(T,T2)) => ~ acquires(R,O,Q,M,T))) => unowned(O,T2))).
% LEMMA (proved in its own problem): Whoever first uses and claims an unowned scarce thing then holds a title against every other person, in every manner.
thf(homesteader_owns, axiom,
    ![P:en,O:en,Q:en,M:man,M2:man,T1:tm,T2:tm]: ((rivalrous(O) & use(P,O,M2,T1) & claim(P,O,T1) & unowned(O,T1) & person(Q) & (P != Q) & before(T1,T2) & nodis_upto(P,O,Q,M,T1,T2)) => owns(P,O,Q,M,T2))).
thf(life_cycle, conjecture,
    ![P:en,S:en,Q:en,O:en,M:man,M2:man,T1:tm,T2:tm,T3:tm]: ((abandons(P,O,T1) & ![R:en]: (is_owner(R,O,T1) => (R = P)) & before(T1,T2) & ![R:en,Q2:en,M3:man,T:tm]: ((((T = T1) | before(T1,T)) & before(T,T2)) => ~ acquires(R,O,Q2,M3,T)) & rivalrous(O) & use(S,O,M2,T2) & claim(S,O,T2) & person(Q) & (S != Q) & before(T2,T3) & nodis_upto(S,O,Q,M,T2,T3)) => owns(S,O,Q,M,T3))).

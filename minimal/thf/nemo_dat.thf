% Libertarian Property Theory v0.23 -- minimal problem for: nemo_dat
% Nobody gives what he does not have: a title that the granter does not hold does not reach the grantee through the grant.
% Generated by source/build.py from source/theory.py. Do not edit.
thf(tm_type, type, tm: $tType).
thf(en_type, type, en: $tType).
thf(man_type, type, man: $tType).
thf(accepts_decl, type, accepts: en > en > en > tm > $o).
thf(acquires_decl, type, acquires: en > en > en > man > tm > $o).
thf(before_decl, type, before: tm > tm > $o).
thf(claim_decl, type, claim: en > en > tm > $o).
thf(grants_decl, type, grants: en > en > en > en > man > tm > $o).
thf(nodis_upto_decl, type, nodis_upto: en > en > en > man > tm > tm > $o).
thf(np_obj_decl, type, np_obj: en > $o).
thf(owns_decl, type, owns: en > en > en > man > tm > $o).
thf(rivalrous_decl, type, rivalrous: en > $o).
thf(unowned_decl, type, unowned: en > tm > $o).
thf(use_decl, type, use: en > en > man > tm > $o).
% A title over an object holds only because of an earlier acquisition event that was not released since.
thf(title_genesis, axiom,
    ![P:en,O:en,Q:en,M:man,T2:tm]: ((owns(P,O,Q,M,T2) & np_obj(O)) => ?[T1:tm]: (before(T1,T2) & acquires(P,O,Q,M,T1) & nodis_upto(P,O,Q,M,T1,T2)))).
% An acquisition event for a title: P homesteads O (uses and claims it while it is scarce and unowned), or P accepts a grant of the title from someone who holds it, or from Q himself.
thf(acquires_def, axiom,
    ![P:en,O:en,Q:en,M:man,T:tm]: (acquires(P,O,Q,M,T) <=> (?[M2:man]: (rivalrous(O) & use(P,O,M2,T) & claim(P,O,T) & unowned(O,T)) | ?[R:en]: (grants(R,P,O,Q,M,T) & accepts(P,R,O,T) & (owns(R,O,Q,M,T) | (Q = R)))))).
thf(nemo_dat, conjecture,
    ![R:en,P:en,O:en,Q:en,M:man,T1:tm,T2:tm]: ((np_obj(O) & grants(R,P,O,Q,M,T1) & (Q != R) & ~ owns(R,O,Q,M,T1) & before(T1,T2) & ![S:en,T:tm]: ((before(T,T2) & grants(S,P,O,Q,M,T)) => ((S = R) & (T = T1))) & ![M2:man,T:tm]: (before(T,T2) => ~ (use(P,O,M2,T) & claim(P,O,T)))) => ~ owns(P,O,Q,M,T2))).

    ![Q:en,O:en,M:man,T:tm]: (unowned(O,T) => may_use(Q,O,M,T))).
thf(nonrival_use_free, conjecture,
    ![Q:en,O:en,M:man,T:tm]: (~ rivalrous(O) => may_use(Q,O,M,T))).

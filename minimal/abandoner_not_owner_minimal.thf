thf(tm_sort,type,tm:$tType). thf(en_sort,type,en:$tType).
thf(person_decl,type,person:en>$o). thf(np_obj_decl,type,np_obj:en>$o). thf(before_decl,type,before:tm>tm>$o).
thf(owns_decl,type,owns:en>en>en>tm>$o). thf(is_owner_decl,type,is_owner:en>en>tm>$o).
thf(disowns_decl,type,disowns:en>en>en>tm>$o). thf(reacquires_decl,type,reacquires:en>en>en>tm>tm>$o). thf(abandons_decl,type,abandons:en>en>tm>$o).
thf(owns_typing,axiom,![P:en,O:en,Q:en,T:tm]:(owns(P,O,Q,T)=>(person(P)&(np_obj(O)|(O=P))&person(Q)&(P!=Q)))).
thf(is_owner_def,axiom,![P:en,O:en,T:tm]:(is_owner(P,O,T)<=> ?[Q:en]:owns(P,O,Q,T))).
thf(disown_extinguishes,axiom,![P:en,O:en,Q:en,T1:tm,T2:tm]:((disowns(P,O,Q,T1)&before(T1,T2)&~reacquires(P,O,Q,T1,T2))=>~owns(P,O,Q,T2))).
% forward direction of abandons_def (the full biconditional is in the main file; verified-equivalent)
thf(abandons_disowns_all,axiom,![P:en,O:en,T:tm]:
  (abandons(P,O,T) => (![Q:en]:((person(Q)&(P!=Q))=>disowns(P,O,Q,T))))).
thf(abandoner_not_owner, conjecture, ![P:en,O:en,T1:tm,T2:tm]:
  ((np_obj(O)&before(T1,T2)&abandons(P,O,T1)&(![Q:en]:~reacquires(P,O,Q,T1,T2))) => ~is_owner(P,O,T2))).

thf(tm_sort,type,tm:$tType). thf(en_sort,type,en:$tType). thf(man_sort,type,man:$tType).
thf(person_decl,type,person:en>$o). thf(np_obj_decl,type,np_obj:en>$o).
thf(owns_decl,type,owns:en>en>en>tm>$o). thf(is_owner_decl,type,is_owner:en>en>tm>$o).
thf(unowned_decl,type,unowned:en>tm>$o). thf(consents_decl,type,consents:en>en>en>man>tm>$o).
thf(may_use_decl,type,may_use:en>en>man>tm>$o). thf(forbidden_use_decl,type,forbidden_use:en>en>man>tm>$o).
thf(entity_disjoint,axiom,![X:en]:~(person(X)&np_obj(X))).
thf(owns_typing,axiom,![P:en,O:en,Q:en,T:tm]:(owns(P,O,Q,T)=>(person(P)&(np_obj(O)|(O=P))&person(Q)&(P!=Q)))).
thf(is_owner_def,axiom,![P:en,O:en,T:tm]:(is_owner(P,O,T)<=> ?[Q:en]:owns(P,O,Q,T))).
thf(unowned_def,axiom,![O:en,T:tm]:(unowned(O,T)<=> ![P:en]:~is_owner(P,O,T))).
thf(self_ownership,axiom,![P:en,Q:en,T:tm]:((person(P)&person(Q)&(P!=Q))=>owns(P,P,Q,T))).
thf(exist_persons,axiom,?[P1:en,P2:en]:(person(P1)&person(P2)&(P1!=P2))).
thf(use_liberty,axiom,![P:en,O:en,M:man,T:tm]:(may_use(P,O,M,T)<=>~forbidden_use(P,O,M,T))).
thf(use_grant,axiom,![Q:en,O:en,M:man,T:tm]:
  (((person(Q)&(np_obj(O)|person(O)))&(![R:en]:(is_owner(R,O,T)=>consents(R,O,Q,M,T))))=>may_use(Q,O,M,T))).
thf(use_veto,axiom,![R:en,O:en,Q:en,M:man,T:tm]:
  ((is_owner(R,O,T)&~consents(R,O,Q,M,T))=>forbidden_use(Q,O,M,T))).
thf(self_consent,axiom,![P:en,O:en,M:man,T:tm]:(is_owner(P,O,T)=>consents(P,O,P,M,T))).
thf(may_use_or_forbidden,conjecture,![P:en,O:en,M:man,T:tm]:(may_use(P,O,M,T)|forbidden_use(P,O,M,T))).

tff('declare_$i1',type,'fmb_$i_1':$i).
tff('finite_domain_$i',axiom,
      ! [X:$i] : (
         X = 'fmb_$i_1'
      ) ).

tff(declare_tm,type,tm:$tType).
tff(declare_tm1,type,fmb_tm_1:tm).
tff(declare_tm2,type,fmb_tm_2:tm).
tff(finite_domain_tm,axiom,
      ! [X:tm] : (
         X = fmb_tm_1 | X = fmb_tm_2
      ) ).

tff(distinct_domain_tm,axiom,
         fmb_tm_1 != fmb_tm_2
).

tff(declare_en,type,en:$tType).
tff(declare_en1,type,fmb_en_1:en).
tff(declare_en2,type,fmb_en_2:en).
tff(declare_en3,type,fmb_en_3:en).
tff(finite_domain_en,axiom,
      ! [X:en] : (
         X = fmb_en_1 | X = fmb_en_2 | X = fmb_en_3
      ) ).

tff(distinct_domain_en,axiom,
         fmb_en_1 != fmb_en_2 & fmb_en_1 != fmb_en_3 & fmb_en_2 != fmb_en_3
).

tff(declare_man,type,man:$tType).
tff(declare_man1,type,fmb_man_1:man).
tff(finite_domain_man,axiom,
      ! [X:man] : (
         X = fmb_man_1
      ) ).

